VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google OAuth (GIS) — Web application Client ID from Google Cloud Console.
# This value is intentionally public (embedded in the browser bundle by design).
# NEVER put client_secret here.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# true  → use VITE_GOOGLE_CLIENT_ID silently (no setup modal shown to users)
# false → show a "Connect Google Drive" modal letting users enter their own Client ID
VITE_USE_ENV_CREDENTIALS=true
